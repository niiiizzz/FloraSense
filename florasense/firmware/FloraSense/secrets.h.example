// Copy to secrets.h (git-ignored) and edit.

// ---- Wi-Fi ----
#define WIFI_SSID "your-wifi"
#define WIFI_PASSWORD "your-password"

// ---- Phone alerts, sent by the ESP32 itself (works even if every server is down) ----
// Install the free "ntfy" app and subscribe to this exact topic. Make it hard to guess.
#define NTFY_TOPIC "florasense-yourname-4821"
#define PLANT_NAME "Your plant"

// ---- Watering rule (lower ADC = wetter). Keep equal to the dashboard Settings. ----
#define WATER_ABOVE_ADC 1800      // needs water at/above this
#define RECOVERED_BELOW_ADC 1500  // watered again below this
#define CONFIRM_DRY_SAMPLES 3
#define CONFIRM_WET_SAMPLES 2
#define REMINDER_MINUTES 60       // 0 = no reminders

// ---- Dashboard server (optional). Leave SERVER_HOST "" to skip. ----
#define SERVER_HOST ""            // e.g. "florasense.onrender.com" (no https://) or a LAN IP
#define SERVER_PORT 443           // 443 for Render (TLS), 3000 for a LAN PC
#define SERVER_USE_TLS 1          // 1 for https, 0 for plain http
#define API_KEY ""                // must match API_KEY on the server
